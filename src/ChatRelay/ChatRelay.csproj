<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ChatRelay</AssemblyName>
    <RootNamespace>ChatRelay</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Roxyz0501</Authors>
    <Company>Roxyz0501</Company>
    <Product>Chat Relay for ACT</Product>
    <Description>Selected FFXIV chat forwarding to Discord webhooks for ACT.</Description>
    <ActPath Condition="'$(ActPath)' == ''">C:\Program Files (x86)\Advanced Combat Tracker\Advanced Combat Tracker.exe</ActPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Advanced Combat Tracker"><HintPath>$(ActPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Drawing" /><Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
